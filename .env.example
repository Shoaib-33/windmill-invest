# Copy to .env for local settings. npm start and npm test read it automatically.
# Without DATABASE_URL, the built-in PostgreSQL (PGlite) stores inquiries in DATA_DIR. Nothing to set up.
# DATA_DIR=data/pglite
# To use a PostgreSQL server instead (see db/setup.sql):
# DATABASE_URL=postgres://windmill:choose-a-password@localhost:5432/windmill
# TEST_DATABASE_URL=postgres://windmill:choose-a-password@localhost:5432/windmill_test
ADMIN_PASSWORD=change-me
# Windmill CRM's Lead API (from the CRM team). Until set, leads wait in the website database.
# CRM_LEAD_API_URL=https://crm.example/api/leads
# CRM_API_TOKEN=
# CRM_SIGNING_SECRET=
